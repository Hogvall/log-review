{
  "name": "log-review",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/wcl --noEmit && tsc -p packages/analysis --noEmit && tsc -p packages/db --noEmit && tsc -p apps/worker --noEmit && tsc -p apps/web --noEmit",
    "spike": "tsx packages/wcl/scripts/spike.ts",
    "measure": "tsx packages/wcl/scripts/measure-costs.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
